# Backend (NestJS) — copy to rental-api/.env

# Server
PORT=8080
NODE_ENV=development
ORIGIN_HOST=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=rental
DB_SYNCHRONIZE=true

# Authentication
JWT_SEC=change-me-to-a-long-random-string

# Bootstrap admin account (created on first startup if missing)
AD_EMAIL=admin@example.com
AD_PASS=change-me
