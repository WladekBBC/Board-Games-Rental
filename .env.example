# ============================================================
# Board Games Rental - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# DATABASE (MySQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=rental
DB_SYNCHRONIZE=true

# ------------------------------------------------------------
# BACKEND (NestJS)
# ------------------------------------------------------------
PORT=8080
NODE_ENV=development
ORIGIN_HOST=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# Authentication
JWT_SEC=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=30d

# Admin account (created on first startup if missing)
AD_EMAIL=admin@example.com
AD_PASS=change-me

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
# Public variables (exposed to browser) - MUST use NEXT_PUBLIC_ prefix
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080

# ------------------------------------------------------------
# DOCKER COMPOSE OVERRIDES
# ------------------------------------------------------------
# Use these in docker-envs/back.env for container-to-container networking:
# DB_HOST=db
# DB_PORT=3306
# DB_USER=root
# DB_PASS=root
# DB_NAME=rental
# DB_SYNCHRONIZE=true
# JWT_SEC=your-production-secret-here
# AD_EMAIL=admin@example.com
# AD_PASS=your-secure-admin-password
# PORT=8080
# NODE_ENV=production
# ORIGIN_HOST=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# MySQL root password (for docker-envs/mysql.env):
# MYSQL_ROOT_PASSWORD=your-secure-root-password
# MYSQL_DATABASE=rental