# Backend (NestJS) - Docker Compose Environment
# Used by rental-api container in docker-compose.yml
# Values here override .env.example for container-to-container networking

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed CORS origins
ORIGIN_HOST=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# ------------------------------------------------------------
# DATABASE (MySQL) - Container networking uses service name 'db'
# ------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=rental
DB_SYNCHRONIZE=true

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------
# JWT secret - MUST be changed in production! Use a strong random string.
JWT_SEC=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------
# BOOTSTRAP ADMIN
# ------------------------------------------------------------
AD_EMAIL=admin@example.com
AD_PASS=change-me