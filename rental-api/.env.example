# Backend (NestJS) - Environment Variables
# Copy to rental-api/.env for local development
# All variables are read from process.env by src/config/env.ts

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed CORS origins
ORIGIN_HOST=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# ------------------------------------------------------------
# DATABASE (MySQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=rental
DB_SYNCHRONIZE=true

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------
# JWT secret - MUST be changed in production! Minimum 32 characters recommended.
JWT_SEC=change-me-to-a-long-random-string-min-32-chars
# JWT token expiration (e.g., "30d", "24h", "7d")
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------
# BOOTSTRAP ADMIN
# ------------------------------------------------------------
# Admin user created on first startup if not exists
AD_EMAIL=admin@example.com
AD_PASS=change-me